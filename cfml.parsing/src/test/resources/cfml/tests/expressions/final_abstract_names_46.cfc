// final and abstract are modifiers, and also ordinary names.
final = 3;
abstract = 4;
combined = final + abstract;
var final = 1;
// The declaration forms have to stay distinguishable from the assignments above.
final limit = 10;
final var total = 0;
// The other modifier keywords, which already worked.
public = 1;
private = 2;
package = 5;
remote = 6;
static = 7;
